*.mdb
*.opendb
*.VC.db
.vsconfig

# Unity crash and build reports
sysinfo.txt
crashlytics-buildid.txt
*.apk
*.aab
*.unitypackage

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Local reference material and raw captures (the submission video lives in Media/)
*.mp4
!/[Mm]edia/*.mp4
